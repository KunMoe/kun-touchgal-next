model patch {
  id                   Int      @id @default(autoincrement())
  unique_id            String   @unique @db.VarChar(8)
  name                 String   @db.VarChar(1007)
  vndb_id              String?  @db.VarChar(107)
  vndb_relation_id     String?  @db.VarChar(107)
  bangumi_id           Int?     @unique
  steam_id             Int?     @unique
  dlsite_code          String?  @unique @db.VarChar(107)
  banner               String   @default("") @db.VarChar(1007)
  introduction         String   @default("") @db.VarChar(100007)
  released             String   @default("unknown") @db.VarChar(107)
  // released 的 YYYYMMDD 排序键 (缺省月/日补 00, 无法解析为 NULL),
  // 由触发器维护, 应用层不写, 见 migration/ensurePatchReleasedSort.ts
  released_sort        Int?
  content_limit        String   @default("") @db.VarChar(107)
  status               Int      @default(0)
  download             Int      @default(0)
  view                 Int      @default(0)
  resource_update_time DateTime @default(now())
  type                 String[]
  language             String[]
  engine               String[]
  platform             String[]

  favorite_count Int @default(0)
  resource_count Int @default(0)
  comment_count  Int @default(0)

  user_id Int
  user    user @relation("user_patch", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  tag             patch_tag_relation[]
  company         patch_company_relation[]
  favorite_folder user_patch_favorite_folder_relation[]

  alias       patch_alias[]
  rating      patch_rating[]
  rating_stat patch_rating_stat?

  resource patch_resource[] @relation("patch_resource")
  comment  patch_comment[]  @relation("patch_comment")
  report   patch_report[]

  created DateTime @default(now())
  updated DateTime @updatedAt

  // 单独 vndb_id / 单独 relation_id (另一半为 NULL) 的唯一性由两个 Prisma 无法
  // 声明的部分唯一索引兜底, 见 prisma/sql/patch_vndb_solo_unique.sql
  // (schema engine 的 diff 会忽略部分索引, db push 不会误删)
  @@unique([vndb_id, vndb_relation_id])
  @@index([created])
  @@index([resource_update_time])
  @@index([content_limit])
  @@index([content_limit, id])
  @@index([released(ops: raw("text_pattern_ops"))])
  @@index([favorite_count])
  @@index([type], type: Gin)
  @@index([language], type: Gin)
  @@index([platform], type: Gin)
  @@index([user_id])
}

model patch_alias {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(1007)
  patch_id Int
  patch    patch  @relation(fields: [patch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  created DateTime @default(now())
  updated DateTime @updatedAt

  @@index([patch_id])
  @@index([name])
}
