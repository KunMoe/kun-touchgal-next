{
  "name": "kun-touchgal-next",
  "version": "1.0.7",
  "description": "TouchGal 是一个一站式 Galgame 文化社区。提供Galgame 论坛、Galgame 下载等服务。承诺永久免费, 高质量。为Galgame 爱好者提供一片净土！",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "pnpm prisma generate",
    "dev:webpack": "next dev --webpack --hostname=127.0.0.1 --port=3000",
    "dev": "next dev --hostname=127.0.0.1 --port=3000",
    "build": "NODE_ENV=production next build",
    "build:sitemap": "esno scripts/generateKunSitemap.ts",
    "backfill:comment-html": "esno scripts/backfillCommentHtml.ts",
    "postbuild": "esno scripts/postbuild.ts",
    "format": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prisma:push": "pnpm prisma db push && pnpm prisma generate",
    "prisma:generate": "pnpm prisma generate",
    "search:init": "esno scripts/search/init.ts",
    "search:sync-all": "esno scripts/search/syncAll.ts",
    "search:reconcile": "esno scripts/search/reconcile.ts",
    "search:engine": "esno scripts/search/engine.ts",
    "search:setup": "esno scripts/search/setup.ts",
    "test": "vitest run",
    "start": "pm2 startOrRestart ecosystem.config.cjs",
    "stop": "pm2 delete ecosystem.config.cjs",
    "deploy:install": "esno scripts/deployInstall.ts",
    "deploy:build": "esno scripts/deployBuild.ts"
  },
