# OIDC Provider（对外身份提供方）
# OIDC_ISSUER：签发者 URL，须带 /oidc 前缀；dev 用 http://127.0.0.1:3000/oidc，生产用 https 域名
OIDC_ISSUER = "http://127.0.0.1:3000/oidc"
# OIDC_JWKS：RS256 私钥 JWK Set 的 JSON 字符串，用 `esno scripts/generateOidcJwks.ts` 生成后填入
OIDC_JWKS = ""
# OIDC_COOKIE_KEYS：provider 自身 interaction/session cookie 的签名密钥，逗号分隔，可填多个用于轮转
OIDC_COOKIE_KEYS = ""
# OIDC_SECRET_ENC_KEY：加密 client_secret 落库用的 KEK（任意高熵字符串），generateOidcJwks 脚本会自动生成
OIDC_SECRET_ENC_KEY = ""

